IMAGE_TAG=2026.09.08
POSTGRES_DB=vetoros
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
VETOROS_MIGRATION_PASSWORD=replace-with-a-long-random-migration-password
VETOROS_RUNTIME_PASSWORD=replace-with-a-long-random-runtime-password
VETOROS_AUTH_PASSWORD=replace-with-a-long-random-auth-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password
MIGRATION_DATABASE_URL=postgresql://vetoros_migration:URL_ENCODED_PASSWORD@postgres:5432/vetoros
DATABASE_URL=postgresql://vetoros_runtime:URL_ENCODED_PASSWORD@postgres:5432/vetoros
AUTH_DATABASE_URL=postgresql://vetoros_auth:URL_ENCODED_PASSWORD@postgres:5432/vetoros
REDIS_URL=redis://:URL_ENCODED_PASSWORD@redis:6379
WEB_ORIGIN=https://vetoros.example.com
NEXT_PUBLIC_API_URL=https://api.vetoros.example.com
SESSION_TTL_SECONDS=28800
# FIS-ADV-01: token de PRODUÇÃO da Focus NFe. Omitir mantém a emissão fiscal desativada de forma
# segura (respostas recuperáveis, nunca uma nota fingida) em vez de travar o resto do sistema.
FOCUS_NFE_API_KEY=
