{
  "name": "vetoros-2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": { "node": ">=24.0.0" },
  "devDependencies": { "@types/node": "^24.0.0", "eslint": "^9.0.0" },
  "scripts": {
    "dev": "pnpm --parallel --filter @vetoros/api --filter @vetoros/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @vetoros/db db:generate",
    "db:migrate": "pnpm --filter @vetoros/db db:migrate",
    "db:seed": "pnpm --filter @vetoros/db db:seed"
  }
}
